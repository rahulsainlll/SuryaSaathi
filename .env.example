# Copy to .env in the app or service that needs it. Never commit real values;
# deployed secrets live in AWS Secrets Manager or SSM Parameter Store.

# all
AWS_REGION=ap-south-1

# services/agents
BEDROCK_MODEL_ID=
VENDOR_DEADLINE_DAYS=3

# tools/device-sim
IOT_ENDPOINT=

# services/whatsapp
WHATSAPP_PHONE_NUMBER_ID=

# apps/web
NEXT_PUBLIC_DEMO_API=
# The public Live endpoint: the Console stack's NEXTPUBLICLIVEAPI output.
NEXT_PUBLIC_LIVE_API=
